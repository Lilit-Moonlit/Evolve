{
  "name": "evolve-dating",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.5.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules/.cache",
    "format": "prettier --write \"**/*.{ts,tsx,md,sol}\"",
    "prepare": "husky install",
    "generate:files": "node scripts/generate-files.js"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "latest",
    "turbo": "latest"
  },
  "lint-staged": {
    "*.{js,ts,tsx,md}": "prettier --write"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1"
  }
}
