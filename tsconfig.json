{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@evolve/core": ["./packages/core/src"],
      "@evolve/storage": ["./packages/storage/src"],
      "@evolve/p2p": ["./packages/p2p/src"],
      "@evolve/ui": ["./packages/ui/src"],
      "@evolve/matching": ["./packages/matching/src"],
    "@evolve/config": ["./packages/config/src"]
    }
  },
  "include": [
    "apps/web/src/**/*",
    "apps/mobile/**/*",
    "packages/core/src/**/*",
    "packages/p2p/src/**/*",
    "packages/storage/src/**/*",
    "packages/ui/src/**/*",
    "packages/matching/src/**/*",
    "packages/config/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "**/artifacts",
    "**/build-info",
    "apps/**/public",
    "packages/**/ignition"
  ]
}
