# PostgreSQL connection for apps/web (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evolve_db?schema=public"

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="your_twilio_phone_number"

# RPC endpoints (optional — defaults in @evolve/core/config/rpc-config.ts)
VITE_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
VITE_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
VITE_RPC_POLYGON=https://polygon-rpc.com/
VITE_RPC_OPTIMISM=https://mainnet.optimism.io/
VITE_RPC_ZKSYNC=https://mainnet.era.zksync.io
VITE_RPC_BASE=https://mainnet.base.org/
VITE_RPC_BSC=https://bsc-dataseed.binance.org:8545/
VITE_RPC_FANTOM=https://rpc.ftm.tools/
VITE_RPC_AURORA=https://mainnet.aurora.dev/
VITE_RPC_CELO=https://forno.celo.org
VITE_RPC_CRONOS=https://evm.cronos.org/
